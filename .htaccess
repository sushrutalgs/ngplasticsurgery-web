RewriteEngine On

# -----------------------------------
# Ignore admin folder
# -----------------------------------
RewriteRule ^admin(?:/|$) - [L]

# -----------------------------------
# Force HTTPS and www
# -----------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.ngplasticsurgery\.in$ [NC]
RewriteRule ^(.*)$ https://www.ngplasticsurgery.in/$1 [R=301,L]

# -----------------------------------
# Custom URL rewrites
# -----------------------------------
RewriteRule ^blog/([a-zA-Z0-9_-]+)$ blog_details.php?title_slug=$1 [L,QSA]
RewriteRule ^category/([a-zA-Z0-9_-]+)$ category_details.php?title_slug=$1 [L,QSA]
RewriteRule ^product/([a-zA-Z0-9_-]+)$ product_details.php?title_slug=$1 [L,QSA]
RewriteRule ^non-surgical-procedure/([a-zA-Z0-9_-]+)$ non_surgical_procedure.php?title_slug=$1 [L,QSA]

# -----------------------------------
# Redirect direct .php URLs to clean URLs
# Example:
# /about.php -> /about
# /contact.php -> /contact
# -----------------------------------
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php(?:[?\s]) [NC]
RewriteCond %{REQUEST_URI} !^/admin/ [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L,NE]

# -----------------------------------
# Internally rewrite clean URL to .php
# Example:
# /about -> /about.php
# -----------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([^/]+)$ $1.php [L]

# -----------------------------------
# Custom 404 page
# -----------------------------------
ErrorDocument 404 /404.php

# -----------------------------------
# Leverage Browser Caching
# -----------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/html "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"

    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    ExpiresByType image/x-icon "access plus 1 year"

    ExpiresDefault "access plus 1 month"
</IfModule>

# -----------------------------------
# Enable Compression
# -----------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
